---
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import Texto from '../components/Texto.astro';
import { reader, dataPorExtenso, formatarTexto } from '../lib/conteudo';
const p = await reader.singletons.politica.readOrThrow();
---
<Base titulo={p.titulo}>
  <section class="intro">
    <div class="intro__texto">
      <div class="intro__cabeca">
        <h1 class="t-titulo-1">{p.titulo}</h1>
        {p.atualizadaEm && <div><Badge>Atualizada em {dataPorExtenso(p.atualizadaEm)}</Badge></div>}
      </div>
      {p.introducao && <p class="intro__bio">{p.introducao}</p>}
    </div>
  </section>
  {p.secoes.map((s) => <Texto titulo={s.titulo} texto={s.texto} />)}
  {p.rodape.pergunta && (
    <section class="texto">
      <p class="secao__rotulo">{p.rodape.pergunta}</p>
      <div class="texto__corpo t-legenda" set:html={formatarTexto(p.rodape.contato)} />
    </section>
  )}
</Base>
