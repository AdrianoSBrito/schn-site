---
import Base from '../layouts/Base.astro';
import Botao from '../components/Botao.astro';
import { reader } from '../lib/conteudo';
const c = await reader.singletons.contato.readOrThrow();

const icone = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6.75" stroke="currentColor" stroke-width="1.5"/><path d="M8 4.75v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="8" cy="11.25" r="0.9" fill="currentColor"/></svg>`;

type Campo = { nome: string; label: string; tipo?: string; placeholder?: string; obrigatorio?: boolean; auto?: string };
const campo = (f: Campo) => f;
const linha1 = [
  campo({ nome: 'nome', label: 'Nome', placeholder: 'Ex.: Adriano Brito', obrigatorio: true, auto: 'name' }),
  campo({ nome: 'email', label: 'E-mail', tipo: 'email', placeholder: 'exemplo@gmail.com', obrigatorio: true, auto: 'email' }),
];
const linha2 = [
  campo({ nome: 'empresa', label: 'Nome da Empresa', placeholder: 'Digite aqui', obrigatorio: true, auto: 'organization' }),
  campo({ nome: 'site', label: 'Site (se houver)', placeholder: 'exemplo.com.br', auto: 'url' }),
];
const linha4 = [
  campo({ nome: 'telefone', label: 'Seu telefone (com DDD)', tipo: 'tel', placeholder: '(xx) xxxxx-xxxx', obrigatorio: true, auto: 'tel' }),
  campo({ nome: 'rede_social', label: 'Sua rede social (opcional)', placeholder: 'Cole o link ou o @' }),
];
const rotulo = (f: Campo) => `${f.label}${f.obrigatorio ? '*' : ''}`;
---
<Base titulo={c.seo.titulo || 'Contato'} descricao={c.seo.descricao}>
  <section class="intro">
    <div class="intro__texto">
      <h1 class="t-titulo-1">{c.titulo}</h1>
      <p class="intro__bio">{c.texto}</p>
    </div>
  </section>

  <form class="form" id="form-contato" novalidate data-chave={c.chaveFormulario} data-sucesso={c.mensagemSucesso}>
    <p class="visualmente-oculto">Campos com * são obrigatórios.</p>
    <div class="form__grupo">
      <div class="form__linha">
        {linha1.map((f) => (
          <div class="campo">
            <label class="campo__label" for={f.nome}>{rotulo(f)}</label>
            <input class="campo__controle" id={f.nome} name={f.nome} type={f.tipo ?? 'text'} placeholder={f.placeholder} autocomplete={f.auto} required={f.obrigatorio} aria-describedby={`${f.nome}-erro`} />
            <p class="campo__erro" id={`${f.nome}-erro`}><Fragment set:html={icone} /><span></span></p>
          </div>
        ))}
      </div>

      <div class="campo">
        <label class="campo__label" for="desafio">Qual é o seu desafio?*</label>
        <textarea class="campo__controle" id="desafio" name="desafio" rows="3" placeholder="O que precisa mudar, para quem e até quando." required aria-describedby="desafio-erro"></textarea>
        <p class="campo__erro" id="desafio-erro"><Fragment set:html={icone} /><span></span></p>
      </div>

      <fieldset class="campo" data-grupo="servicos" aria-describedby="servicos-erro">
        <legend class="campo__label">Tipo de serviço*</legend>
        <div class="opcoes">
          {c.servicos.map((s) => (
            <label class="checkbox"><input type="checkbox" name="servicos" value={s} /><span>{s}</span></label>
          ))}
        </div>
        <p class="campo__erro" id="servicos-erro"><Fragment set:html={icone} /><span></span></p>
      </fieldset>

      <div class="campo">
        <label class="campo__label" for="investimento">Qual a disponibilidade de investimento no design do seu projeto?*</label>
        <select class="campo__controle" id="investimento" name="investimento" required aria-describedby="investimento-erro">
          <option value="" disabled selected>Selecione uma faixa</option>
          {c.investimento.map((o) => <option value={o}>{o}</option>)}
        </select>
        <p class="campo__erro" id="investimento-erro"><Fragment set:html={icone} /><span></span></p>
      </div>
    </div>

    <div class="form__grupo">
      <div class="form__linha">
        {linha2.map((f) => (
          <div class="campo">
            <label class="campo__label" for={f.nome}>{rotulo(f)}</label>
            <input class="campo__controle" id={f.nome} name={f.nome} type="text" placeholder={f.placeholder} autocomplete={f.auto} required={f.obrigatorio} aria-describedby={`${f.nome}-erro`} />
            <p class="campo__erro" id={`${f.nome}-erro`}><Fragment set:html={icone} /><span></span></p>
          </div>
        ))}
      </div>
      <div class="form__linha">
        <div class="campo">
          <label class="campo__label" for="cargo">Seu cargo*</label>
          <input class="campo__controle" id="cargo" name="cargo" type="text" placeholder="Ex.: CEO" autocomplete="organization-title" required aria-describedby="cargo-erro" />
          <p class="campo__erro" id="cargo-erro"><Fragment set:html={icone} /><span></span></p>
        </div>
        <div class="campo">
          <label class="campo__label" for="colaboradores">N° de colaboradores*</label>
          <select class="campo__controle" id="colaboradores" name="colaboradores" required aria-describedby="colaboradores-erro">
            <option value="" disabled selected>Selecione</option>
            {c.colaboradores.map((o) => <option value={o}>{o}</option>)}
          </select>
          <p class="campo__erro" id="colaboradores-erro"><Fragment set:html={icone} /><span></span></p>
        </div>
      </div>
      <div class="campo">
        <label class="campo__label" for="origem">Como conheceu o estúdio?*</label>
        <input class="campo__controle" id="origem" name="origem" type="text" placeholder="Redes sociais, indicação, etc." required aria-describedby="origem-erro" />
        <p class="campo__erro" id="origem-erro"><Fragment set:html={icone} /><span></span></p>
      </div>
      <div class="form__linha">
        {linha4.map((f) => (
          <div class="campo">
            <label class="campo__label" for={f.nome}>{rotulo(f)}</label>
            <input class="campo__controle" id={f.nome} name={f.nome} type={f.tipo ?? 'text'} placeholder={f.placeholder} autocomplete={f.auto} required={f.obrigatorio} aria-describedby={`${f.nome}-erro`} />
            <p class="campo__erro" id={`${f.nome}-erro`}><Fragment set:html={icone} /><span></span></p>
          </div>
        ))}
      </div>
    </div>

    <input type="checkbox" name="botcheck" class="visualmente-oculto" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <div class="form__fim">
      <div class="campo" data-grupo="consentimento">
        <label class="checkbox">
          <input type="checkbox" name="consentimento" value="sim" aria-describedby="consentimento-erro" />
          <span>Aceito a <a href="/politica-de-privacidade" target="_blank">política de privacidade</a> do site.</span>
        </label>
        <p class="campo__erro" id="consentimento-erro"><Fragment set:html={icone} /><span></span></p>
      </div>
      <Botao type="submit" tamanho="lg">{c.rotuloEnviar}</Botao>
    </div>
    <p class="form__aviso" role="status" aria-live="polite" hidden></p>
  </form>
</Base>

<script>
  const form = document.getElementById('form-contato') as HTMLFormElement;
  const aviso = form.querySelector('.form__aviso') as HTMLElement;
  const botao = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const chave = form.dataset.chave || '';

  const mensagens: Record<string, string> = {
    email: 'Confira o e-mail: falta o @ ou o domínio.',
    servicos: 'Escolha pelo menos um tipo de serviço.',
    consentimento: 'Para enviar, aceite a política de privacidade.',
    padrao: 'Preencha este campo.',
    selecao: 'Escolha uma opção.',
  };

  function marcar(alvo: HTMLElement, msg: string | null) {
    const caixa = alvo.closest('.campo') as HTMLElement;
    if (!caixa) return;
    const texto = caixa.querySelector('.campo__erro span') as HTMLElement;
    const controle = caixa.querySelector('.campo__controle, input');
    if (msg) {
      caixa.dataset.erro = '';
      texto.textContent = msg;
      controle?.setAttribute('aria-invalid', 'true');
    } else {
      delete caixa.dataset.erro;
      texto.textContent = '';
      controle?.removeAttribute('aria-invalid');
    }
  }

  function validar(): HTMLElement | null {
    let primeiro: HTMLElement | null = null;
    const erro = (el: HTMLElement, msg: string | null) => { marcar(el, msg); if (msg && !primeiro) primeiro = el; };
    form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('.campo__controle').forEach((el) => {
      const v = el.value.trim();
      if (el.required && !v) erro(el, el.tagName === 'SELECT' ? mensagens.selecao : mensagens.padrao);
      else if (el.type === 'email' && v && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) erro(el, mensagens.email);
      else marcar(el, null);
    });
    const servicos = form.querySelectorAll<HTMLInputElement>('input[name="servicos"]');
    erro(servicos[0], [...servicos].some((s) => s.checked) ? null : mensagens.servicos);
    const consent = form.querySelector<HTMLInputElement>('input[name="consentimento"]')!;
    erro(consent, consent.checked ? null : mensagens.consentimento);
    return primeiro;
  }

  form.addEventListener('input', (e) => {
    const alvo = e.target as HTMLElement;
    if (alvo.closest('.campo[data-erro]')) marcar(alvo, null);
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    aviso.hidden = true;
    const primeiro = validar();
    if (primeiro) { primeiro.focus(); return; }
    if (!chave) {
      aviso.dataset.tipo = 'erro';
      aviso.textContent = 'O formulário ainda não está recebendo mensagens. Escreva para o e-mail do rodapé.';
      aviso.hidden = false;
      return;
    }
    const dados = new FormData(form);
    const corpo: Record<string, string> = {
      access_key: chave,
      subject: `Novo contato pelo site: ${dados.get('nome')}`,
      from_name: 'Site Schn Estúdio',
    };
    for (const [k, v] of dados.entries()) {
      if (k === 'servicos') corpo.servicos = corpo.servicos ? `${corpo.servicos}, ${v}` : String(v);
      else corpo[k] = String(v);
    }
    botao.disabled = true;
    try {
      const r = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(corpo),
      });
      const json = await r.json();
      if (!r.ok || !json.success) throw new Error(json.message);
      form.reset();
      aviso.dataset.tipo = 'sucesso';
      aviso.textContent = form.dataset.sucesso || 'Mensagem enviada.';
    } catch {
      aviso.dataset.tipo = 'erro';
      aviso.textContent = 'Não foi possível enviar agora. Tente de novo em alguns minutos ou escreva para o e-mail do rodapé.';
    } finally {
      aviso.hidden = false;
      botao.disabled = false;
      aviso.focus?.();
    }
  });
</script>
